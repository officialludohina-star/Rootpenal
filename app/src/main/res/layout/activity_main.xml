<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="16dp">

    <!-- Header with X icon -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Root Panel"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <ImageButton
            android:id="@+id/iconX"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Close"
            android:layout_gravity="end|center_vertical"
            android:scaleType="centerInside" />

    </FrameLayout>

    <!-- Main Launcher Section -->
    <LinearLayout
        android:id="@+id/freeFireCard"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/launcher_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Free Fire"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/launchFFBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launch_ff"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/purple_500" />

    </LinearLayout>

    <!-- Mod Menu Container (Hidden by default) -->
    <ScrollView
        android:id="@+id/modMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Aim Assist -->
            <CheckBox
                android:id="@+id/aimAssistCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aim_assist"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- Silent Aim -->
            <CheckBox
                android:id="@+id/silentAimCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/silent_aim"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- Auto Aim -->
            <CheckBox
                android:id="@+id/autoAimCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_aim"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- ESP Box -->
            <CheckBox
                android:id="@+id/espBoxCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esp_box"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- ESP Line -->
            <CheckBox
                android:id="@+id/espLineCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esp_line"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- ESP Name -->
            <CheckBox
                android:id="@+id/espNameCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esp_name"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- ESP Health -->
            <CheckBox
                android:id="@+id/espHealthCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esp_health"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- ESP Distance -->
            <CheckBox
                android:id="@+id/espDistanceCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/esp_distance"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- Headshot Only -->
            <CheckBox
                android:id="@+id/headshotOnlyCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/headshot_only"
                android:textColor="@color/white"
                android:padding="8dp"
                android:enabled="false" />

            <!-- Smooth Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smooth"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/smoothSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:enabled="false" />

            </LinearLayout>

            <!-- FOV Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fov"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/fovSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="120"
                    android:progress="90"
                    android:enabled="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
